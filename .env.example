# Frontend: set this only for a separately deployed Python API origin.
# VITE_API_BASE_URL="https://your-python-api.example"

# Python API: local-only defaults are safe for development.
# API_HOST="127.0.0.1"
# API_PORT="5001"
# Comma-separated frontend origins permitted to call the API.
# ALLOWED_ORIGINS="https://dashboard.example.com"
# Optional bearer token. Keep this server-side; do not expose it as VITE_*.
# API_AUTH_TOKEN="replace-with-a-secret-from-your-secret-manager"
