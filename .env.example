# Frontend: set this only for a separately deployed Python API origin.
# VITE_API_BASE_URL="https://your-python-api.example"

# Python API: local-only defaults are safe for development.
# API_HOST="127.0.0.1"
# API_PORT="5001"
# Comma-separated frontend origins permitted to call the API.
# ALLOWED_ORIGINS="https://dashboard.example.com"
# Optional bearer token. Keep this server-side; do not expose it as VITE_*.
# API_AUTH_TOKEN="replace-with-a-secret-from-your-secret-manager"

# Docker Compose: bind locally by default. Set to an internal ingress interface only when needed.
# DASHBOARD_BIND_ADDRESS="127.0.0.1"
# DASHBOARD_PORT="8080"
# SERVING_CACHE_DIR="C:/absolute/path/to/verified/serving-cache"

# Single-container portfolio deployment: URL and checksum are required when the serving
# cache is not embedded or mounted. Use a versioned HTTPS release asset, never a mutable URL.
# SERVING_BUNDLE_URL="https://github.com/OWNER/REPOSITORY/releases/download/serving-cache-v1/serving-cache-v1.zip"
# SERVING_BUNDLE_SHA256="64-character-lowercase-sha256"
